  <ifrs-full:FinancialLiabilitiesAtFairValue contextRef="PFY2024eFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_SeparateMember_ifrs-full_CategoriesOfFinancialLiabilitiesAxis_dart_DerivativeLiabilitiesMember" unitRef="KRW" decimals="0">284038988791</ifrs-full:FinancialLiabilitiesAtFairValue>
