  <dart:NameOfTheInstitutionMakingTheCommitments contextRef="CFY2026dFQA_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00139214_ProvisionOfReinsuranceCollateralAndLcOpeningLimitAgreementMemberOfFinancialInstitutionCovenantsMemberOfDisclosureOfCommitmentsTableOfMember" xml:lang="ko">런던씨티은행</dart:NameOfTheInstitutionMakingTheCommitments>
