  <dart:CommitmentsAmount contextRef="PFY2025eFQ_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_dart_TypesOfCommitmentsAxis_entity00113058_InsuranceCommitmentsMemberOfTypesOfCommitmentsMemberOfDisclosureOfInsuranceCommitmentsAndTrustAccountsTableOfMember" unitRef="KRW" decimals="-6">304005549000000</dart:CommitmentsAmount>
